{
  "name": "dj-copilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "setup": "bash scripts/setup-python.sh && pnpm install && pnpm --dir app/desktop install:electron",
    "dev": "pnpm --dir app/desktop dev",
    "build": "pnpm --dir app/desktop build",
    "test": "pnpm test:core && pnpm test:desktop",
    "test:core": "python3 -B -m unittest discover -s core/tests -v",
    "test:desktop": "pnpm --dir app/desktop test",
    "typecheck": "pnpm --dir app/desktop typecheck",
    "verify:m1": "bash scripts/verify-m1.sh",
    "verify:m2": "bash scripts/verify-m2.sh",
    "verify:m3": "bash scripts/verify-m3.sh",
    "verify:m4": "bash scripts/verify-m4.sh",
    "verify:m5": "bash scripts/verify-m5.sh",
    "verify:m6": "bash scripts/verify-m6.sh",
    "verify:m7": "bash scripts/verify-m7.sh",
    "smoke:m6:real": "pnpm --dir app/desktop smoke:m6:real",
    "smoke:m7:real": "bash scripts/release/smoke-real-codex.sh",
    "build:release:ffmpeg": "bash scripts/release/build-ffmpeg.sh",
    "build:release:core": "bash scripts/release/build-core.sh",
    "package:mac": "bash scripts/release/compose-personal-arm64.sh",
    "verify:package": "bash scripts/release/verify-personal-arm64.sh \"out/DJ Copilot-darwin-arm64/DJ Copilot.app\""
  }
}
