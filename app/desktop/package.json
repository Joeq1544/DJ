{
  "name": "@dj-copilot/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "install:electron": "install-electron --no",
    "dev": "concurrently --kill-others-on-fail --names renderer,bundle,electron \"pnpm dev:renderer\" \"pnpm dev:bundle\" \"pnpm dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:bundle": "node scripts/build-main.mjs --watch",
    "dev:electron": "wait-on http://127.0.0.1:5173 dist/main/main.cjs dist/preload/index.cjs && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "electron": "43.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  }
}
